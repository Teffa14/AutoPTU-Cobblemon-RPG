  "qualityIntent": {
    "referenceLessons": [
      "Ruins Style: use segmented parented drape planes and progressive rotation to avoid one rigid slab while preserving animation contact.",
      "Space Style: carry shell language around torso sides and into limbs instead of concentrating the costume on one frontal face.",
      "Covert Style: connect head, torso and rear garment masses into one readable full-body costume while preserving openings for face and limbs."
    ],
    "signaturePieces": [
      "Diagonal mantle that wraps from chest around both torso sides",
      "Open rear aura halo built around a large central void",
      "Tapered split front/rear sash continuing into both legs"
    ],
    "macroFormPlan": "Replace V45 plate language with a continuous diagonal cowl-to-mantle flow, lateral torso wrapping, asymmetrical open halo, tapered split sash, rear tails and lower-body continuation. Preserve negative space at the center front and inside the halo.",
    "paintPlan": "Use a non-uniform cool value ramp derived from the exact official normal texture: deepen dark regions, separate blue midtones, lift selected light planes and add low-amplitude hue/value variation. Cosmetic material slots use their own pale-blue/navy ramp. This remains an ARTISTIC FAIL until Blockbench review proves the paint is deliberate enough.",
    "gameplayReadGoal": "At 160 px, the silhouette must read as one Aura Sentinel transformation through the diagonal shoulder mass, open dorsal halo and split lower-body sash rather than Lucario plus isolated plates.",
    "antiPatternsToReject": [
      "Pokemon base plus scattered accessories",
      "rectangular cage or portal-frame silhouette",
      "broad frontal armor slabs",
      "flat recolor without painted depth"
    ],
