{
  "schemaVersion": 1,
  "id": "autoptu_cobblemon_rpg_fabric_adapter",
  "version": "${version}",
  "name": "AutoPTU Cobblemon RPG Fabric Adapter",
  "description": "Server-authoritative Fabric networking and Cobblemon presentation adapter for AutoPTU.",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.autoptu.cobblemon.fabric.AutoPtuCobblemonFabricAdapter",
      "io.autoptu.cobblemon.fabric.admin.FabricBattleEvidenceAdminRuntime",
      "io.autoptu.cobblemon.fabric.rpg.FabricNurseryEntrypoint",
      "io.autoptu.cobblemon.fabric.rpg.FabricLeagueRegistrationEntrypoint",
      "io.autoptu.cobblemon.fabric.rpg.FabricMailboxEntrypoint",
      "io.autoptu.cobblemon.fabric.rpg.FabricPartyQuickAccessEntrypoint",
      "io.autoptu.cobblemon.fabric.world.MareaWildHabitatCueEntrypoint",
      "io.autoptu.cobblemon.fabric.world.WildAmbientBehaviorRuntime",
      "io.autoptu.cobblemon.fabric.world.WildCalmIdleLookRuntime",
      "io.autoptu.cobblemon.fabric.world.MareaWildCalmIdleLookRuntime",
      "io.autoptu.cobblemon.fabric.world.WildCalmReciprocalYieldRuntime",
      "io.autoptu.cobblemon.fabric.world.WildCalmCollisionNavigationRuntime",
      "io.autoptu.cobblemon.fabric.world.WildCalmNavigationRecoveryRuntime",
      "io.autoptu.cobblemon.fabric.world.WildCalmNavigationContinuityRuntime"
    ],
    "client": [
      "io.autoptu.cobblemon.fabric.client.FabricRpgVisualEvidenceClient",
      "io.autoptu.cobblemon.fabric.client.FabricBattleVisualEvidenceClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.17.2",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=1.13.6",
    "cobblemon": ">=1.7.3",
    "minecraft": "1.21.1",
    "java": ">=21"
  }
}
