  "qualityIntent": {
    "referenceLessons": [
      "Use layered parent-safe cloth masses across head and torso so a costume reads as one continuous character design, not scattered add-ons.",
      "Carry authored material continuity through animated body regions so gameplay motion preserves the transformation.",
      "Use overlapping shells, contour transitions and material hierarchy while preserving every official biological UV and animation bone."
    ],
    "signaturePieces": [
      "Fully enclosed irregular folded white cap with dominant left blue ribbon",
      "Narrow uninterrupted white torso and long sleeves with periwinkle cuffs, oversized charcoal gloves and silver clasp",
      "Continuous deep white apron beginning at the waist, with blue visible only outside/rear and a restrained lavender hem"
    ],
    "macroFormPlan": "V38 removes the remaining waist discontinuity and fragmented skirt logic. One white waist bridge overlaps one deep apron body; blue under-skirt is limited to one rear and two outer side masses.",
    "paintPlan": "Normal/shiny derive independently from exact official 1.7.3 baselines. Ear UVs are charcoal, cream landmarks cool grey/white, and tail UVs dark teal to prevent the base tail from becoming the dominant costume read.",
    "gameplayReadGoal": "At 160 px the costume must read as the supplied maid/chef Lucario before the base species: folded white cap, obvious left blue ribbon, white torso/arms, dark gloves and a broad continuous white hip/apron mass.",
    "antiPatternsToReject": [
      "Exposed ear holes through cap",
      "Black waist gap",
      "Blue triangles breaking the apron center",
      "Detached apron placard",
      "Bright tail dominating 3/4 silhouette",
      "Any change to official biological bones or battle-state authority"
    ],
